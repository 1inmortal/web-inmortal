# ============================================================
# .gitignore - web-inmortal
# El CI/CD construye los dist/ automaticamente, no se commitean
# ============================================================

# Dependencias
node_modules/
**/node_modules/

# Builds generados por CI - NO commitear, se generan automaticamente
dist/
**/dist/
build/
**/build/

# Variables de entorno
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor y sistema operativo
.DS_Store
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db

# Cache de herramientas
.eslintcache
.stylelintcache
.cache/
.parcel-cache/
.vite/
**/.vite/

# Cobertura de tests
coverage/
**/coverage/
.nyc_output/

# Temporales
*.tmp
*.temp
.temp/
.tmp/
